    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "node scripts/clean.mjs && tsdown && vite build --config vite.client.config.ts && vite build --config vite.native-ui.config.ts && tsc -p tsconfig.json --emitDeclarationOnly && tsc -p tsconfig.client.json --emitDeclarationOnly",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit && tsc -p tsconfig.native-ui.json --noEmit && tsc -p tsconfig.tests.json --noEmit && tsc -p tsconfig.tests.client.json --noEmit",
    "test": "vitest run",
    "verify:closure": "node --test scripts/runtime-closure.spec.mjs && node scripts/verify-runtime-closure.mjs",
    "verify:cli": "node scripts/verify-cli-runtime.mjs",
    "verify:loader": "node scripts/verify-loader-boot.mjs",
    "verify:profile": "node scripts/verify-profile-boot.mjs",
    "verify:licenses": "node scripts/verify-licenses.mjs",
    "verify:operations": "node --test scripts/operation-reliability.spec.mjs && node scripts/verify-operation-reliability.mjs",
    "verify:notices": "node scripts/verify-licenses.mjs --notices THIRD_PARTY_NOTICES.md",
    "check": "yarn run build && yarn run typecheck && yarn run test && yarn run verify:closure && yarn run verify:cli && yarn run verify:loader && yarn run verify:profile && yarn run verify:aa && yarn run verify:licenses && yarn run verify:operations",
    "check:win-package": "yarn run check:win-package:platform && yarn run typecheck",
    "check:win-package:platform": "yarn workspace dsh-community-market build && yarn run build && vitest run tests/package.spec.ts tests/package-win.spec.ts tests/desktop-installer-quit.spec.ts tests/installer-nsh.spec.ts tests/update-checker.spec.ts tests/update-download.spec.ts tests/verify-win-installer.spec.ts tests/verify-win-portable.spec.ts tests/verify-packaged-runtime.spec.ts tests/windows-pwsh-sandbox.spec.ts tests/windows-console-host.spec.ts tests/windows-volume-diagnostics.spec.ts tests/window-options.spec.ts tests/safe-mode.spec.ts && yarn run verify:closure",
    "check:mac-package": "yarn run check:mac-package:platform && yarn run typecheck",
    "check:mac-package:platform": "yarn workspace dsh-community-market build && yarn run build && vitest run tests/package.spec.ts tests/package-mac.spec.ts tests/verify-mac-smoke.spec.ts tests/verify-mac-release.spec.ts tests/mac-entitlements.spec.ts tests/verify-packaged-runtime.spec.ts tests/mac-universal.spec.ts && yarn run verify:closure",
    "check:linux-package": "yarn run check:linux-package:platform && yarn run typecheck",
    "check:linux-package:platform": "yarn workspace dsh-community-market build && yarn run build && vitest run tests/package.spec.ts tests/package-linux.spec.ts tests/verify-linux-artifacts.spec.ts tests/verify-packaged-runtime.spec.ts && yarn run verify:closure",
    "start": "node lib/bin.js",
    "dev": "yarn run build && yarn run prepare:electron-native && node lib/bin.js",
    "package:dir": "yarn run build && yarn run prepare:electron-native && node scripts/package-dir.mjs",
    "dist:mac": "node scripts/release-mac.ts",
    "dist:mac-smoke": "node scripts/package-mac.ts",
    "dist:win": "node scripts/package-win.ts",
    "dist:win-portable": "node scripts/package-win-portable.ts",
    "dist:linux": "node scripts/package-linux.ts",
    "prepack": "yarn run check",
    "verify:aa": "node ../scripts/prepare-agents-anywhere-runtime.mjs && DSH_VERIFY_AA=1 node scripts/verify-profile-boot.mjs",
    "prepare:electron-native": "node scripts/prepare-fs-ext.ts",
    "icons:export": "node ../scripts/export-app-icons.mjs --channel stable"
  },
