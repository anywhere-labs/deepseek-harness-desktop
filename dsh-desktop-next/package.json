      "default": "./lib/permissions.js"
    },
    "./package.json": "./package.json",
    "./webserver": "./lib/webserver.js"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "optionalBundles": [
      "dsh-community-market",
      "dshmarket",
      "@agents-anywhere/dsh-bridge-next"
    ],
    "exclusiveBundles": [
      [
        "dsh-community-market",
        "dshmarket"
      ]
    ]
  },
  "build": {
    "appId": "ai.deepseek.dsh.desktop.next",
    "productName": "DSH NEXT",
    "asar": false,
    "npmRebuild": false,
    "afterPack": "./scripts/verify-packaged.ts",
    "afterAllArtifactBuild": "./scripts/verify-fuses.ts",
    "electronFuses": {
      "enableEmbeddedAsarIntegrityValidation": false,
      "onlyLoadAppFromAsar": false,
      "resetAdHocDarwinSignature": true,
      "runAsNode": true
    },
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "toolsets": {
      "nsis": "1.2.1"
    },
    "files": [
      "assets/**",
      "build/app-icon.ico",
      "build/app-icon.png",
      "build/app-icon-mac.png",
      "cordis.patch.yml",
      "host.cordis.patch.yml",
      "lib/**",
      "package.json",
      "scripts/node-bin/**",
      "!node_modules/node-pty/build/**",
      "!node_modules/fs-ext/build/**"
    ],
    "mac": {
      "artifactName": "DSH-NEXT-${version}-${arch}.${ext}",
      "target": [
        "dir"
      ],
      "category": "public.app-category.developer-tools",
      "extendInfo": {
        "CFBundleAllowMixedLocalizations": true,
        "CFBundleDevelopmentRegion": "en",
        "CFBundleLocalizations": [
          "en",
          "zh_CN"
        ],
        "NSMicrophoneUsageDescription": "DSH NEXT uses the microphone when you enable a feature that records audio.",
        "NSAudioCaptureUsageDescription": "DSH NEXT captures screen audio when you request it.",
        "NSLocalNetworkUsageDescription": "DSH NEXT connects to devices on your local network when you enable network access.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      },
      "hardenedRuntime": true,
      "entitlements": "../deepseek-harness/apps/desktop/scripts/macos-entitlements.plist",
      "entitlementsInherit": "../deepseek-harness/apps/desktop/scripts/macos-entitlements.plist",
      "icon": "build/app-icon.icon",
      "mergeASARs": false,
      "notarize": true,
      "signIgnore": [
        "\\.(?:pak|dat|wasm)$"
      ],
      "x64ArchFiles": "**/node_modules/{@deepseek-ai/node-addon-system-darwin-*/**,node-pty/prebuilds/darwin-*/**,fs-ext/prebuilds/darwin-*/**,node-addon-require-builtin-darwin-*/**,@vscode/ripgrep-darwin-*/**,@img/sharp-darwin-*/**,@img/sharp-libvips-darwin-*/**,@koromix/koffi-darwin-*/**,@dataiku/uv-darwin-*/**,@deepseek-ai/libreoffice-kit-darwin-*/**,sherpa-onnx-darwin-*/**,@trycua/cua-driver-darwin-*/**,@ubjs/node-darwin-*/**}",
      "asar": false
    },
    "win": {
      "compression": "normal",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "DSH-NEXT-${version}-${arch}-Portable.${ext}",
      "icon": "build/app-icon.ico",
      "asar": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "differentialPackage": false,
      "shortcutName": "DSH NEXT",
      "useZip": false,
      "artifactName": "DSH-NEXT-${version}-${arch}-Setup.${ext}",
      "installerIcon": "build/app-icon.ico",
      "uninstallerIcon": "build/app-icon.ico",
      "include": "../dsh-plugin-desktop-beta/build/installer.nsh"
    },
    "linux": {
      "target": [
        "dir"
      ],
      "icon": "build/app-icon.png",
      "asar": false
    },
    "dmg": {
      "icon": "build/app-icon.icns"
    }
  }
