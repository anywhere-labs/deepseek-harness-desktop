+// @vitest-environment jsdom
+import { afterEach, beforeEach, describe, expect, it } from 'vitest'
+import { act, cleanup, render } from '@testing-library/react'
+import type { SessionId, SessionSeq } from '@deepseek-ai/dsh-session/types'
+import type { MessageId } from '@deepseek-ai/dsh-llm/brand'
+import { createSnapshotStore } from '@deepseek-ai/dsh-client-store'
+import { MutableSessionEventSource } from '@deepseek-ai/dsh-api-session-controller/src/client/contract/events.ts'
+import { observableHook } from '../../ui-renderer/src/client/bindings.tsx'
+import { createPlanCommentsStore, planCommentKey } from '../src/client/plan-comments.ts'
+import { PlanRevisionReceipt } from '../src/client/PlanRevisionReceipt.tsx'
+import { watchRevisionSubmissions } from '../src/client/revision-submissions.ts'
+
+beforeEach(() => { localStorage.clear() })
+afterEach(cleanup)
+
+describe('plan revision delivery cleanup', () => {
+  it('keeps the submitted revision independent of other draft edits and clears only on its new recorded message', () => {
+    const sessionId = 'revision-receipt' as SessionId
+    const key = planCommentKey(sessionId, 'request', '# Plan')
+    const comments = createPlanCommentsStore().create(sessionId)
+    comments.actions.save({ id: 'note', planKey: key, quote: 'Plan', note: 'Change it', start: 0, end: 4 })
+    comments.actions.stage(key, 'revision draft', ['note'], 20)
+    const input = createSnapshotStore({ draft: 'revision draft' })
+    const source = new MutableSessionEventSource()
+    const append = (text: string, seq: number): void => {
+      source.append({ type: 'event', event: { type: 'user/message', surfaceOp: 'append', seq: seq as SessionSeq, time: seq, data: {
+        id: `receipt-${seq}` as MessageId, role: 'user', source: { kind: 'user' }, content: [{ type: 'text', text }],
+      } } })
+    }
+    append('revision draft', 10)
+    const props = { sessionId, actions: comments.actions, useStore: observableHook(comments), useInput: observableHook(input),
+      watchSubmitted: (receipt: (text: string, seq: number) => void) => watchRevisionSubmissions(source, receipt),
+    } as Parameters<typeof PlanRevisionReceipt>[0]
+    render(<PlanRevisionReceipt {...props} />)
+    expect(comments.getSnapshot().commentsByPlan[key]).toHaveLength(1)
+    act(() => { input.set({ draft: 'edited revision draft' }) })
+    expect(comments.getSnapshot().stagedByPlan[key]?.draft).toBe('revision draft')
+    // No recorded message means failed or queued input cannot consume notes.
+    act(() => { input.set({ draft: '' }) })
+    expect(comments.getSnapshot().commentsByPlan[key]).toHaveLength(1)
+    act(() => { input.set({ draft: 'an unrelated later draft' }); append('an unrelated later draft', 21) })
+    expect(comments.getSnapshot().commentsByPlan[key]).toHaveLength(1)
+    act(() => { append('edited revision draft', 22) })
+    expect(comments.getSnapshot().commentsByPlan[key]).toHaveLength(1)
+    act(() => { append('revision draft', 23) })
+    expect(comments.getSnapshot().commentsByPlan[key]).toBeUndefined()
+    expect(comments.getSnapshot().stagedByPlan[key]).toBeUndefined()
+  })
+
+  it('confirms a revision staged immediately before a synchronous recorded event', () => {
+    const sessionId = 'synchronous-receipt' as SessionId
+    const key = planCommentKey(sessionId, 'request', '# Plan')
+    const comments = createPlanCommentsStore().create(sessionId)
+    const source = new MutableSessionEventSource()
+    const props = { actions: comments.actions, useStore: observableHook(comments),
+      watchSubmitted: (receipt: (text: string, seq: number) => void) => watchRevisionSubmissions(source, receipt),
+    }
+    render(<PlanRevisionReceipt {...props} />)
+    act(() => {
+      comments.actions.save({ id: 'note', planKey: key, quote: 'Plan', note: 'Change it', start: 0, end: 4 })
+      comments.actions.stage(key, 'revision request', ['note'], 20)
+      source.append({ type: 'event', event: { type: 'user/message', surfaceOp: 'append', seq: 21 as SessionSeq, time: 21, data: {
+        id: 'sync-receipt' as MessageId, role: 'user', source: { kind: 'user' }, content: [{ type: 'text', text: 'revision request' }],
+      } } })
+    })
+    expect(comments.getSnapshot().commentsByPlan[key]).toBeUndefined()
+    expect(comments.getSnapshot().stagedByPlan[key]).toBeUndefined()
+  })
+
+  it('confirms a restored revision from successful history without consuming comments for an older message', () => {
+    const sessionId = 'restored-receipt' as SessionId
+    const key = planCommentKey(sessionId, 'request', '# Plan')
+    const original = createPlanCommentsStore().create(sessionId)
+    original.actions.save({ id: 'note', planKey: key, quote: 'Plan', note: 'Change it', start: 0, end: 4 })
+    original.actions.stage(key, 'revision request', ['note'], 20)
+    const comments = createPlanCommentsStore().create(sessionId)
+    const source = new MutableSessionEventSource()
+    const append = (seq: number): void => {
+      source.append({ type: 'event', event: { type: 'user/message', surfaceOp: 'append', seq: seq as SessionSeq, time: seq, data: {
+        id: `restored-${seq}` as MessageId, role: 'user', source: { kind: 'user' }, content: [{ type: 'text', text: 'revision request' }],
+      } } })
+    }
+    append(10)
+    const props = { actions: comments.actions, useStore: observableHook(comments),
+      watchSubmitted: (receipt: (text: string, seq: number) => void) => watchRevisionSubmissions(source, receipt),
+    }
+    const view = render(<PlanRevisionReceipt {...props} />)
+    expect(comments.getSnapshot().commentsByPlan[key]).toHaveLength(1)
+    view.unmount()
+    append(21)
+    render(<PlanRevisionReceipt {...props} />)
+    expect(comments.getSnapshot().commentsByPlan[key]).toBeUndefined()
+  })
+})
