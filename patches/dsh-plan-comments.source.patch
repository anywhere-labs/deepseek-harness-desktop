+// @vitest-environment jsdom
+import { describe, expect, it } from 'vitest'
+import { planHighlightRanges, planTextRange, renderedPlanText, selectionPlanAnchor } from '../src/client/comment-dom.ts'
+
+function documentOf(html: string): HTMLDivElement {
+  const root = document.createElement('div')
+  root.innerHTML = html
+  return root
+}
+
+describe('rendered plan comment anchors', () => {
+  it('anchors across inline code and emphasis without changing their nodes', () => {
+    const root = documentOf('<p>  Review <code>serial</code> and <strong>parallel</strong> now  </p>')
+    const paragraph = root.firstElementChild!
+    const range = document.createRange()
+    range.setStart(paragraph.firstChild!, 0)
+    range.setEnd(paragraph.lastChild!, paragraph.lastChild!.textContent!.length)
+    const anchor = selectionPlanAnchor(root, range)!
+    expect(anchor).toEqual({ quote: 'Review serial and parallel now', start: 2, end: 32, prefix: '  ', suffix: '  ' })
+    expect(planTextRange(root, anchor.start, anchor.end)?.toString()).toBe(anchor.quote)
+    expect(planHighlightRanges(root, anchor.start, anchor.end).map(segment => segment.toString()).join('')).toBe(anchor.quote)
+    expect(root.innerHTML).toBe('<p>  Review <code>serial</code> and <strong>parallel</strong> now  </p>')
+  })
+  it('keeps duplicate text at its selected occurrence and captures surrounding context', () => {
+    const root = documentOf('<p>Same <em>item</em>, then same <em>item</em>.</p>')
+    const second = root.querySelectorAll('em')[1]!.firstChild!
+    const range = document.createRange()
+    range.setStart(second, 0)
+    range.setEnd(second, 4)
+    const anchor = selectionPlanAnchor(root, range)!
+    expect(anchor.quote).toBe('item')
+    expect(anchor.start).toBe(21)
+    expect(anchor.prefix).toBe('Same item, then same ')
+    expect(planTextRange(root, anchor.start, anchor.end)?.startContainer).toBe(second)
+  })
+  it('excludes generated controls and handles element-boundary selections', () => {
+    const root = documentOf('<div><div data-code-block-banner>Code<button>Copy</button></div><p>first <code>second</code> third</p></div>')
+    const paragraph = root.querySelector('p')!
+    const range = document.createRange()
+    range.selectNodeContents(paragraph)
+    expect(renderedPlanText(root)).toBe('first second third')
+    expect(selectionPlanAnchor(root, range)).toMatchObject({ start: 0, end: 18, quote: 'first second third' })
+    expect(planTextRange(root, 6, 12)?.toString()).toBe('second')
+  })
+  it('ignores collapsed, whitespace-only, outside and out-of-document selections', () => {
+    const root = documentOf('<p>  plan  </p>')
+    const range = document.createRange()
+    range.setStart(root.firstElementChild!.firstChild!, 0)
+    range.setEnd(root.firstElementChild!.firstChild!, 2)
+    expect(selectionPlanAnchor(root, range)).toBeUndefined()
+    range.collapse()
+    expect(selectionPlanAnchor(root, range)).toBeUndefined()
+    range.selectNodeContents(documentOf('elsewhere'))
+    expect(selectionPlanAnchor(root, range)).toBeUndefined()
+    expect(planTextRange(root, -1, 2)).toBeUndefined()
+    expect(planTextRange(root, 2, 2)).toBeUndefined()
+    expect(planTextRange(root, 2, 99)).toBeUndefined()
+    expect(planHighlightRanges(root, 2, 99)).toEqual([])
+  })
+})
