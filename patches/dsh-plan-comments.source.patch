+// @vitest-environment jsdom
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+import { act, cleanup, fireEvent, render, screen } from '@testing-library/react'
+import type { SessionId } from '@deepseek-ai/dsh-session/types'
+import type { ToolCallId } from '@deepseek-ai/dsh-llm/brand'
+import type { InputState } from '@deepseek-ai/dsh-client-ui-conversation/client'
+import { createSnapshotStore } from '@deepseek-ai/dsh-client-store'
+import { makeTranslate } from '@deepseek-ai/dsh-client-test-runtime'
+import { en as commonEn } from '@deepseek-ai/dsh-client-locale/src/locales/en.ts'
+import { PendingQuestion, planReviewOf } from '../../ui-user-questions/src/client/contract/slots.ts'
+import { observableHook } from '../../ui-renderer/src/client/bindings.tsx'
+import { PlanReviewSurface } from '../src/client/PlanReviewSurface.tsx'
+import { createPlanCommentsStore, planCommentKey, type PlanComment } from '../src/client/plan-comments.ts'
+import { en } from '../src/client/locales.ts'
+
+const SID = 'surface-session' as SessionId
+const CALL = 'review-call' as ToolCallId
+const PLAN = '# Ship the picker\n\nRead the store before implementation.'
+const t = makeTranslate(en, commonEn)
+
+beforeEach(() => { localStorage.clear() })
+afterEach(() => { cleanup(); vi.restoreAllMocks() })
+
+function fixture(options: { readOnly?: boolean; draft?: string; attachments?: InputState['attachmentIds']; busy?: boolean; decline?: boolean; rpc?: boolean } = {}) {
+  const questions = [{ id: 'plan-review', question: 'Approve this plan?', detail: PLAN, options: [{ label: 'Approve' }, ...options.decline === true ? [{ label: 'Request changes' }] : []], intent: { kind: 'plan-review' as const, approve: 'Approve', callId: CALL } }]
+  const pending = new PendingQuestion(SID, questions, CALL, undefined, options.readOnly === true ? [{ id: 'plan-review', selected: ['Approve'] }] : undefined)
+  if (options.readOnly !== true) {
+    if (options.rpc === true) {
+      pending.setState('continued')
+      pending.attachRpc({ answer: vi.fn(async () => true) })
+    } else pending.attachWaterfall({ deadline: undefined, resolve: vi.fn(), reject: vi.fn(), delegate: vi.fn() })
+  }
+  const review = planReviewOf(questions)!
+  const key = planCommentKey(SID, CALL, PLAN)
+  const comments = createPlanCommentsStore().create(SID)
+  const input = createSnapshotStore<InputState>({ draft: options.draft ?? '', attachmentIds: options.attachments ?? [], draftRev: 0, phase: 'plain', occurrences: [], queue: [] })
+  const setDraft = vi.fn((draft: string) => { input.set({ ...input.getSnapshot(), draft }) })
+  const dismiss = vi.fn(async () => true)
+  const answer = vi.spyOn(pending, 'answer')
+  const approve = vi.fn()
+  const unbind = vi.fn()
+  const bindReview = vi.fn(() => unbind)
+  const focusComposer = vi.fn()
+  const sendRevision = vi.fn(async (_text: string) => {})
+  const props = {
+    pending, review, requestKey: pending.key, preview: <button type="button">View full plan</button>, card: pending.snapshot(), busy: options.busy ?? false,
+    error: null, approve, dismiss, sessionId: SID, inputActions: { setDraft }, useInput: observableHook(input),
+    submissionCursor: () => 100, t, useStore: observableHook(comments), actions: comments.actions, bindReview, focusComposer, sendRevision,
+  } as Parameters<typeof PlanReviewSurface>[0]
+  const note = (id: string, quote = 'Read the store'): PlanComment => ({ id, planKey: key, quote, note: `Requested change ${id}`, start: 0, end: quote.length })
+  return { props, comments, key, note, setDraft, input, dismiss, answer, approve, bindReview, unbind, focusComposer, sendRevision }
+}
+
+function variant(): string | null {
+  expect(document.querySelectorAll('[data-plan-review-surface]')).toHaveLength(1)
+  return document.querySelector('[data-plan-review-surface]')!.getAttribute('data-plan-review-variant')
+}
+
+describe('one plan review surface', () => {
+  it('switches the existing root to revision for the first comment and back after deleting the last', () => {
+    const f = fixture()
+    render(<PlanReviewSurface {...f.props} />)
+    const original = document.querySelector('[data-plan-review-surface]')
+    expect(variant()).toBe('review')
+    expect(screen.getByRole('button', { name: 'Approve' })).toBeTruthy()
+    act(() => { f.comments.actions.save(f.note('a')) })
+    expect(variant()).toBe('revision')
+    expect(document.querySelector('[data-plan-review-surface]')).toBe(original)
+    expect(screen.queryByRole('button', { name: 'Approve' })).toBeNull()
+    expect(screen.getByRole('button', { name: 'Revise plan' })).toBeTruthy()
+    fireEvent.click(screen.getByRole('button', { name: 'Delete comment' }))
+    expect(variant()).toBe('review')
+    expect(document.querySelector('[data-plan-review-surface]')).toBe(original)
+    expect(screen.queryByRole('button', { name: 'Revise plan' })).toBeNull()
+  })
+
+  it('deletes selected comments together and keeps the one card and preview opener', () => {
+    const f = fixture()
+    f.comments.actions.save(f.note('a'))
+    f.comments.actions.save(f.note('b', 'before implementation'))
+    render(<PlanReviewSurface {...f.props} />)
+    for (const checkbox of screen.getAllByRole('checkbox')) fireEvent.click(checkbox)
+    fireEvent.click(screen.getByRole('button', { name: 'Delete selected' }))
+    expect(variant()).toBe('review')
+    expect(screen.queryAllByRole('checkbox')).toHaveLength(0)
+    expect(screen.getByRole('button', { name: 'View full plan' })).toBeTruthy()
+  })
+
+  it('keeps saved comments readable while hiding mutation controls on a settled review', async () => {
+    const f = fixture({ readOnly: true })
+    f.comments.actions.save(f.note('a'))
+    render(<PlanReviewSurface {...f.props} />)
+    expect(variant()).toBe('revision')
+    expect(screen.getByText('Requested change a')).toBeTruthy()
+    expect(screen.queryByRole('checkbox')).toBeNull()
+    expect(screen.queryByRole('button', { name: 'Delete comment' })).toBeNull()
+    expect(screen.queryByRole('button', { name: 'Revise plan' })).toBeNull()
+    expect(screen.queryByRole('button', { name: 'Cancel plan' })).toBeNull()
+    expect(screen.getAllByRole('button')).toHaveLength(2)
+    fireEvent.click(screen.getByRole('button', { name: 'Close' }))
+    await vi.waitFor(() => { expect(f.dismiss).toHaveBeenCalledOnce() })
+    expect(f.comments.getSnapshot().commentsByPlan[f.key]).toHaveLength(1)
+    expect(f.comments.getSnapshot().editableByPlan[f.key]).toBeUndefined()
+  })
+
+  it('sends only the revision prompt and retains comments until recorded delivery, preserving draft and attachments', async () => {
+    const f = fixture({ draft: 'Existing user draft', attachments: ['user-file' as InputState['attachmentIds'][number]] })
+    const before = f.input.getSnapshot()
+    f.comments.actions.save(f.note('a'))
+    render(<PlanReviewSurface {...f.props} />)
+    fireEvent.click(screen.getByRole('button', { name: 'Revise plan' }))
+    await vi.waitFor(() => { expect(f.dismiss).toHaveBeenCalledOnce() })
+    const text = f.sendRevision.mock.calls[0]![0]
+    expect(text).toBe('Please revise the plan using these comments:\n\n1. “Read the store”\n   Requested change: Requested change a')
+    expect(f.dismiss).toHaveBeenCalledOnce()
+    expect(f.sendRevision.mock.invocationCallOrder[0]).toBeLessThan(f.answer.mock.invocationCallOrder[0]!)
+    expect(f.answer.mock.invocationCallOrder[0]).toBeLessThan(f.dismiss.mock.invocationCallOrder[0]!)
+    expect(f.answer).toHaveBeenCalledExactlyOnceWith({ answers: [{ id: 'plan-review', selected: [] }] })
+    expect(f.setDraft).not.toHaveBeenCalled()
+    expect(f.focusComposer).not.toHaveBeenCalled()
+    expect(f.input.getSnapshot()).toBe(before)
+    expect(f.comments.getSnapshot().commentsByPlan[f.key]).toHaveLength(1)
+    expect(f.comments.getSnapshot().stagedByPlan[f.key]).toEqual({ draft: text, ids: ['a'], afterSeq: 100 })
+    act(() => { f.comments.actions.confirmSubmitted('Unrelated message', 101) })
+    expect(variant()).toBe('revision')
+    act(() => { f.comments.actions.confirmSubmitted(text, 101) })
+    expect(variant()).toBe('review')
+  })
+
+  it('retains an accepted revision when dismissal fails and retries closing without another prompt', async () => {
+    const f = fixture({ draft: 'Keep this draft' })
+    f.comments.actions.save(f.note('a'))
+    f.dismiss.mockResolvedValue(false)
+    render(<PlanReviewSurface {...f.props} />)
+    fireEvent.click(screen.getByRole('button', { name: 'Revise plan' }))
+    await vi.waitFor(() => { expect(f.dismiss).toHaveBeenCalledOnce() })
+    expect(f.setDraft).not.toHaveBeenCalled()
+    expect(f.sendRevision).toHaveBeenCalledOnce()
+    expect(f.comments.getSnapshot().stagedByPlan[f.key]).toBeDefined()
+    expect(f.comments.getSnapshot().commentsByPlan[f.key]).toHaveLength(1)
+    expect(f.input.getSnapshot().draft).toBe('Keep this draft')
+    expect(f.focusComposer).not.toHaveBeenCalled()
+    fireEvent.click(screen.getByRole('button', { name: 'Revise plan' }))
+    await vi.waitFor(() => { expect(f.dismiss).toHaveBeenCalledTimes(2) })
+    expect(f.sendRevision).toHaveBeenCalledOnce()
+    expect(f.comments.getSnapshot().commentsByPlan[f.key]).toHaveLength(1)
+    expect(f.focusComposer).not.toHaveBeenCalled()
+  })
+
+  it('retains comments after a send failure and permits retry without changing the user draft', async () => {
+    const f = fixture({ draft: 'Keep this draft' })
+    f.comments.actions.save(f.note('a'))
+    f.sendRevision.mockRejectedValueOnce(new Error('Offline'))
+    render(<PlanReviewSurface {...f.props} />)
+    fireEvent.click(screen.getByRole('button', { name: 'Revise plan' }))
+    await vi.waitFor(() => { expect(screen.getByRole('status').textContent).toBe('Offline') })
+    expect(f.comments.getSnapshot().commentsByPlan[f.key]).toHaveLength(1)
+    expect(f.comments.getSnapshot().stagedByPlan[f.key]).toBeUndefined()
