+// @vitest-environment jsdom
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+import { cleanup, fireEvent, render, screen } from '@testing-library/react'
+import type { SessionId } from '@deepseek-ai/dsh-session/types'
+import { makeTranslate } from '@deepseek-ai/dsh-client-test-runtime'
+import { en as commonEn } from '@deepseek-ai/dsh-client-locale/src/locales/en.ts'
+import { en } from '../src/client/locales.ts'
+import { PlanPreview } from '../src/client/PlanPreview.tsx'
+import { createPlanCommentsStore, planCommentKey, type PlanCommentsState } from '../src/client/plan-comments.ts'
+
+beforeEach(() => {
+  localStorage.clear()
+  Object.defineProperty(Range.prototype, 'getBoundingClientRect', { configurable: true, value: () => new DOMRect(30, 20, 160, 18) })
+  Object.defineProperty(Range.prototype, 'getClientRects', { configurable: true, value: () => [new DOMRect(30, 20, 80, 18), new DOMRect(30, 38, 160, 18)] })
+})
+afterEach(() => {
+  cleanup()
+  window.getSelection()?.removeAllRanges()
+  Reflect.deleteProperty(Range.prototype, 'getBoundingClientRect')
+  Reflect.deleteProperty(Range.prototype, 'getClientRects')
+})
+
+function preview(markdown = '# Plan\n\nReview **parallel** and `serial` now.') {
+  const sessionId = 'plan-selection-session' as SessionId
+  const planKey = planCommentKey(sessionId, 'call-selection', markdown)
+  const store = createPlanCommentsStore().create(sessionId)
+  store.actions.setEditable(planKey, true)
+  const holdReviewFocus = vi.fn()
+  const releaseReviewFocus = vi.fn()
+  const props = {
+    sessionId, t: makeTranslate(en, commonEn), actions: store.actions, holdReviewFocus, releaseReviewFocus,
+    useStore: <S,>(select: (state: PlanCommentsState) => S): S => select(store.getSnapshot()),
+    useResource: () => ({ status: 'live', value: { callId: 'call-selection', title: 'Plan', markdown } }),
+    useTabInfo: () => ({ tab: { title: 'Plan', navigation: { address: 'dsh-resource://plan/plan-selection-session/call-selection' } } }),
+  } as Parameters<typeof PlanPreview>[0]
+  const view = render(<PlanPreview {...props} />)
+  return { ...view, props, planKey, store, holdReviewFocus, releaseReviewFocus }
+}
+
+function selectParagraph(container: HTMLElement): void {
+  const paragraph = container.querySelector('p')!
+  const range = document.createRange()
+  range.selectNodeContents(paragraph)
+  const selection = window.getSelection()!
+  selection.removeAllRanges()
+  selection.addRange(range)
+  fireEvent.mouseUp(paragraph)
+}
+
+describe('plan comment preview', () => {
+  it('saves cross-node selections, shows hover comments, and edits or removes a highlight', () => {
+    const view = preview()
+    selectParagraph(view.container)
+    expect(view.holdReviewFocus).toHaveBeenCalledWith(view.planKey)
+    fireEvent.change(screen.getByRole('textbox'), { target: { value: 'Keep existing behavior.' } })
+    fireEvent.click(screen.getByRole('button', { name: en['comment.save'] }))
+    expect(view.store.getSnapshot().commentsByPlan[view.planKey]?.[0]).toMatchObject({ quote: 'Review parallel and serial now.', note: 'Keep existing behavior.' })
+    expect(view.releaseReviewFocus).toHaveBeenCalledWith(view.planKey)
+    expect(screen.queryByRole('dialog')).toBeNull()
+    const mark = view.container.querySelector<HTMLElement>('[data-plan-comment-mark]')!
+    fireEvent.mouseEnter(mark)
+    expect(screen.getByRole('tooltip').textContent).toBe('Keep existing behavior.')
+    fireEvent.click(mark)
+    expect(screen.getByRole('textbox').getAttribute('placeholder')).toBe(en['comment.placeholder'])
+    expect(screen.getByRole<HTMLTextAreaElement>('textbox').value).toBe('Keep existing behavior.')
+    fireEvent.change(screen.getByRole('textbox'), { target: { value: 'Keep parity.' } })
+    fireEvent.click(screen.getByRole('button', { name: en['comment.save'] }))
+    expect(view.store.getSnapshot().commentsByPlan[view.planKey]).toHaveLength(1)
+    expect(view.store.getSnapshot().commentsByPlan[view.planKey]?.[0]?.note).toBe('Keep parity.')
+    fireEvent.click(view.container.querySelector('[data-plan-comment-mark]')!)
+    fireEvent.click(screen.getByRole('button', { name: en['comment.delete'] }))
+    expect(view.store.getSnapshot().commentsByPlan[view.planKey]).toBeUndefined()
+    expect(view.container.querySelector('[data-plan-comment-mark]')).toBeNull()
+    expect(view.container.querySelector('strong')?.textContent).toBe('parallel')
+    expect(view.container.querySelector('code')?.textContent).toBe('serial')
+  })
+  it('keeps textarea newlines and composition input from submitting and closes on Escape or outside click', () => {
+    const view = preview()
+    selectParagraph(view.container)
+    const textarea = screen.getByRole('textbox')
+    fireEvent.change(textarea, { target: { value: '修改边界\n保持原行为' } })
+    fireEvent.keyDown(textarea, { key: 'Enter' })
+    expect(screen.getByRole('dialog')).toBeTruthy()
+    fireEvent.compositionStart(textarea)
+    fireEvent.keyDown(textarea, { key: 'Enter', ctrlKey: true, isComposing: true })
+    expect(view.store.getSnapshot().commentsByPlan[view.planKey]).toBeUndefined()
+    fireEvent.compositionEnd(textarea)
+    fireEvent.keyDown(textarea, { key: 'Escape' })
+    expect(screen.queryByRole('dialog')).toBeNull()
+    selectParagraph(view.container)
+    fireEvent.pointerDown(document.body)
+    expect(screen.queryByRole('dialog')).toBeNull()
+    expect(view.releaseReviewFocus).toHaveBeenCalledTimes(2)
+    selectParagraph(view.container)
+    view.unmount()
+    expect(view.releaseReviewFocus).toHaveBeenCalledTimes(3)
+  })
+  it('closes an active editor when the request becomes read-only while preserving hover notes', () => {
+    const view = preview()
+    selectParagraph(view.container)
+    fireEvent.change(screen.getByRole('textbox'), { target: { value: 'Review this.' } })
+    fireEvent.click(screen.getByRole('button', { name: en['comment.save'] }))
+    fireEvent.click(view.container.querySelector('[data-plan-comment-mark]')!)
+    view.store.actions.setEditable(view.planKey, false)
+    view.rerender(<PlanPreview {...view.props} />)
+    expect(screen.queryByRole('dialog')).toBeNull()
+    const mark = view.container.querySelector('[data-plan-comment-mark]')!
+    fireEvent.mouseEnter(mark)
+    expect(screen.getByRole('tooltip').textContent).toBe('Review this.')
+    fireEvent.click(mark)
+    selectParagraph(view.container)
+    expect(screen.queryByRole('dialog')).toBeNull()
+    expect(view.releaseReviewFocus).toHaveBeenCalledTimes(2)
+  })
+  it('restores highlights after remount and reports unresolved originals without drawing them', () => {
+    const view = preview()
+    selectParagraph(view.container)
+    fireEvent.change(screen.getByRole('textbox'), { target: { value: 'Remember this.' } })
+    fireEvent.click(screen.getByRole('button', { name: en['comment.save'] }))
+    view.unmount()
+    const restored = preview()
+    expect(restored.container.querySelector('[data-plan-comment-mark]')).not.toBeNull()
+    restored.store.actions.save({ id: 'missing', planKey: restored.planKey, quote: 'Unknown source', note: 'Update it.', start: 100, end: 114 })
+    restored.rerender(<PlanPreview {...restored.props} />)
+    expect(restored.store.getSnapshot().missingByPlan[restored.planKey]).toEqual(['missing'])
+    expect(restored.container.querySelector('[data-plan-comment-mark="missing"]')).toBeNull()
