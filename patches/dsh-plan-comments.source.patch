+import { describe, expect, it, vi } from 'vitest'
+import { MutableSessionEventSource } from '@deepseek-ai/dsh-api-session-controller/src/client/contract/events.ts'
+import type { SessionEventLikeEntry } from '@deepseek-ai/dsh-api-session-controller/client'
+import type { SessionSeq } from '@deepseek-ai/dsh-session/types'
+import type { MessageId, ToolCallId } from '@deepseek-ai/dsh-llm/brand'
+import { watchRevisionSubmissions } from '../src/client/revision-submissions.ts'
+
+function user(text: string, seq: number, source: 'user' | 'tool' = 'user'): SessionEventLikeEntry {
+  return { type: 'event', event: { type: 'user/message', seq: seq as SessionSeq, time: seq, surfaceOp: 'append', data: {
+    id: `message-${seq}` as MessageId, role: 'user', source: source === 'user' ? { kind: 'user' } : { kind: 'tool', callId: 'receipt-tool' as ToolCallId }, content: [{ type: 'text', text }],
+  } } }
+}
+
+describe('revision submission receipts', () => {
+  it('observes restored successful user text and then only exact live deltas', () => {
+    const source = new MutableSessionEventSource()
+    source.replace([user('saved draft', 1)], false)
+    const receipt = vi.fn()
+    const dispose = watchRevisionSubmissions(source, receipt)
+    expect(receipt.mock.calls).toEqual([['saved draft', 1]])
+    source.append(user('revision draft', 2))
+    expect(receipt.mock.calls).toEqual([['saved draft', 1], ['revision draft', 2]])
+    source.append(user('tool notification', 3, 'tool'))
+    expect(receipt).toHaveBeenCalledTimes(2)
+    dispose()
+    source.append(user('after disposal', 4))
+    expect(receipt).toHaveBeenCalledTimes(2)
+  })
+  it('does not manufacture receipts from assistant or transient output', () => {
+    const source = new MutableSessionEventSource()
+    const receipt = vi.fn()
+    const dispose = watchRevisionSubmissions(source, receipt)
+    source.append({ type: 'transient', event: { type: 'assistant/live-chunk', seq: 1, time: 1, data: {} } } as SessionEventLikeEntry)
+    source.append({ type: 'event', event: { type: 'assistant/message', seq: 2, time: 2, data: {} } } as SessionEventLikeEntry)
+    expect(receipt).not.toHaveBeenCalled()
+    source.append(user('sent manually', 3))
+    expect(receipt).toHaveBeenCalledWith('sent manually', 3)
+    dispose()
+  })
+})
