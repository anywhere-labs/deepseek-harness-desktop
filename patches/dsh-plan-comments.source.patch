+// @vitest-environment jsdom
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+import type { SessionId } from '@deepseek-ai/dsh-session/types'
+import {
+  createPlanCommentsStore, EMPTY_PLAN_COMMENTS, locatePlanComment, planCommentKey, type PlanComment,
+} from '../src/client/plan-comments.ts'
+
+const sessionA = 'session-a' as SessionId
+const sessionB = 'session-b' as SessionId
+const planKey = planCommentKey(sessionA, 'call-a', '# Plan\nReview this text')
+const comment: PlanComment = {
+  id: 'comment-a', planKey, quote: 'Review', note: 'Add a test', start: 0, end: 6,
+  prefix: '', suffix: ' this text',
+}
+
+beforeEach(() => { localStorage.clear() })
+afterEach(() => { vi.restoreAllMocks() })
+
+describe('plan comment persistence', () => {
+  it('restores comments and pending revision after reload, leaving editability transient', () => {
+    const first = createPlanCommentsStore().create(sessionA)
+    first.actions.save(comment)
+    first.actions.setEditable(planKey, true)
+    first.actions.setSending(planKey, true)
+    first.actions.stage(planKey, 'Revision draft', [comment.id], 100)
+    const restored = createPlanCommentsStore().create(sessionA)
+    expect(restored.getSnapshot().commentsByPlan[planKey]).toEqual([comment])
+    expect(restored.getSnapshot().stagedByPlan[planKey]).toEqual({ draft: 'Revision draft', ids: [comment.id], afterSeq: 100 })
+    expect(restored.getSnapshot().editableByPlan[planKey]).toBeUndefined()
+    expect(first.getSnapshot().sendingByPlan[planKey]).toBe(true)
+    expect(restored.getSnapshot().sendingByPlan[planKey]).toBeUndefined()
+    expect(JSON.parse(localStorage.getItem(`dsh.plan-comments.v1.${sessionA}`)!).sendingByPlan).toBeUndefined()
+  })
+
+  it('keeps independent session instances and keys', () => {
+    const handle = createPlanCommentsStore()
+    const first = handle.create(sessionA)
+    const second = handle.create(sessionB)
+    first.actions.save(comment)
+    expect(second.getSnapshot().commentsByPlan[planKey]).toBeUndefined()
+    expect(handle.create(sessionB).getSnapshot().commentsByPlan[planKey]).toBeUndefined()
+    expect(planCommentKey(sessionB, 'call-a', '# Plan\nReview this text')).not.toBe(planKey)
+    expect(planCommentKey(sessionA, 'call-b', '# Plan\nReview this text')).not.toBe(planKey)
+    expect(planCommentKey(sessionA, 'call-a', '# New plan')).not.toBe(planKey)
+  })
+
+  it('keeps the empty snapshot reference stable and notifies consumers for edits', () => {
+    const store = createPlanCommentsStore().create(sessionA)
+    const first = store.getSnapshot()
+    const notify = vi.fn()
+    const unsubscribe = store.subscribe(notify)
+    expect(store.getSnapshot()).toBe(first)
+    expect(first.commentsByPlan[planKey] ?? EMPTY_PLAN_COMMENTS).toBe(EMPTY_PLAN_COMMENTS)
+    store.actions.save(comment)
+    expect(notify).toHaveBeenCalledTimes(1)
+    store.actions.save({ ...comment, note: 'Revised comment' })
+    expect(store.getSnapshot().commentsByPlan[planKey]).toEqual([{ ...comment, note: 'Revised comment' }])
+    unsubscribe()
+    store.actions.clear(planKey)
+    expect(notify).toHaveBeenCalledTimes(2)
+  })
+
+  it('filters invalid durable anchors, key mismatches, and duplicate ids', () => {
+    localStorage.setItem(`dsh.plan-comments.v1.${sessionA}`, JSON.stringify({
+      commentsByPlan: {
+        [planKey]: [comment, comment, { ...comment, id: 'negative', start: -1 }, { ...comment, id: 'fraction', start: 0.5 },
+          { ...comment, id: 'range', end: 5 }, { ...comment, id: 'empty', note: '  ' }, { ...comment, id: 'wrong-key', planKey: 'other' },
+          { ...comment, id: 'bad-context', prefix: 1 }],
+        other: 'not an array',
+      },
+      stagedByPlan: { [planKey]: { draft: 'Draft', ids: [comment.id, 'missing', 1, comment.id], afterSeq: 100 } },
+    }))
+    const restored = createPlanCommentsStore().create(sessionA)
+    expect(restored.getSnapshot().commentsByPlan[planKey]).toEqual([comment])
+    expect(restored.getSnapshot().stagedByPlan[planKey]).toEqual({ draft: 'Draft', ids: [comment.id], afterSeq: 100 })
+  })
+
+  it('starts clean for malformed storage and continues through browser read/write failures', () => {
+    localStorage.setItem(`dsh.plan-comments.v1.${sessionA}`, '{invalid')
+    const malformed = createPlanCommentsStore().create(sessionA)
+    expect(malformed.getSnapshot().commentsByPlan[planKey]).toBeUndefined()
+    vi.spyOn(Storage.prototype, 'getItem').mockImplementation(() => { throw new DOMException('Unavailable') })
+    vi.spyOn(Storage.prototype, 'setItem').mockImplementation(() => { throw new DOMException('Quota exceeded') })
+    const unavailable = createPlanCommentsStore().create(sessionA)
+    expect(() => { unavailable.actions.save(comment) }).not.toThrow()
+    expect(unavailable.getSnapshot().commentsByPlan[planKey]).toEqual([comment])
+    vi.spyOn(Storage.prototype, 'removeItem').mockImplementation(() => { throw new DOMException('Unavailable') })
+    expect(() => { unavailable.clearPersisted() }).not.toThrow()
+  })
+
+  it('removes only staged ids after the exact draft is delivered', () => {
+    const store = createPlanCommentsStore().create(sessionA)
+    store.actions.save(comment)
+    store.actions.stage(planKey, 'Draft', [comment.id], 100)
+    const later = { ...comment, id: 'comment-b', note: 'Later note' }
+    store.actions.save(later)
+    store.actions.confirm(planKey, 'Edited draft', 101)
+    expect(store.getSnapshot().commentsByPlan[planKey]).toEqual([comment, later])
+    expect(store.getSnapshot().stagedByPlan[planKey]).toBeDefined()
+    store.actions.confirm(planKey, 'Draft', 101)
+    expect(store.getSnapshot().commentsByPlan[planKey]).toEqual([later])
+    expect(store.getSnapshot().stagedByPlan[planKey]).toBeUndefined()
+  })
+
+  it('unstages a failed matching request without deleting comments or a newer request', () => {
+    const store = createPlanCommentsStore().create(sessionA)
+    store.actions.save(comment)
+    store.actions.stage(planKey, 'Newer request', [comment.id], 100)
+    store.actions.unstage(planKey, 'Older request')
+    expect(store.getSnapshot().stagedByPlan[planKey]?.draft).toBe('Newer request')
+    store.actions.unstage(planKey, 'Newer request')
+    expect(store.getSnapshot().stagedByPlan[planKey]).toBeUndefined()
+    expect(store.getSnapshot().commentsByPlan[planKey]).toEqual([comment])
+  })
+
+  it('confirms the current stage synchronously without consuming unrelated revisions or later notes', () => {
+    const store = createPlanCommentsStore().create(sessionA)
+    const otherKey = planCommentKey(sessionA, 'call-b', '# Other plan')
+    store.actions.save(comment)
+    store.actions.save({ ...comment, id: 'other', planKey: otherKey })
+    store.actions.stage(planKey, 'Revision request', [comment.id], 100)
+    store.actions.stage(otherKey, 'Other request', ['other'], 100)
+    const later = { ...comment, id: 'later', note: 'Keep this later note' }
+    store.actions.save(later)
+    store.actions.confirmSubmitted('Revision request', 100)
+    expect(store.getSnapshot().commentsByPlan[planKey]).toEqual([comment, later])
+    store.actions.confirmSubmitted('Revision request', 101)
+    expect(store.getSnapshot().commentsByPlan[planKey]).toEqual([later])
+    expect(store.getSnapshot().stagedByPlan[planKey]).toBeUndefined()
+    expect(store.getSnapshot().commentsByPlan[otherKey]).toHaveLength(1)
+    expect(store.getSnapshot().stagedByPlan[otherKey]).toBeDefined()
+  })
+
+  it('retains a new revision when identical earlier successful user text is replayed', () => {
+    const store = createPlanCommentsStore().create(sessionA)
+    store.actions.save(comment)
+    store.actions.stage(planKey, 'Same revision draft', [comment.id], 100)
+    store.actions.confirm(planKey, 'Same revision draft', 50)
+    store.actions.confirm(planKey, 'Same revision draft', 100)
+    expect(store.getSnapshot().commentsByPlan[planKey]).toEqual([comment])
+    const restored = createPlanCommentsStore().create(sessionA)
+    restored.actions.confirm(planKey, 'Same revision draft', 50)
+    expect(restored.getSnapshot().commentsByPlan[planKey]).toEqual([comment])
+    restored.actions.confirm(planKey, 'Same revision draft', 101)
+    expect(restored.getSnapshot().commentsByPlan[planKey]).toBeUndefined()
+  })
+
+  it('restores a revision staged before the first durable event', () => {
+    const store = createPlanCommentsStore().create(sessionA)
+    store.actions.save(comment)
+    store.actions.stage(planKey, 'First revision draft', [comment.id], -1)
+    const restored = createPlanCommentsStore().create(sessionA)
+    expect(restored.getSnapshot().stagedByPlan[planKey]?.afterSeq).toBe(-1)
+    restored.actions.confirm(planKey, 'First revision draft', 0)
+    expect(restored.getSnapshot().commentsByPlan[planKey]).toBeUndefined()
+  })
+
+  it('clears all comments and the staged revision on explicit cancellation', () => {
+    const store = createPlanCommentsStore().create(sessionA)
+    store.actions.save(comment)
+    store.actions.save({ ...comment, id: 'comment-b' })
+    store.actions.stage(planKey, 'Draft', [comment.id], 100)
+    store.actions.remove(planKey, [comment.id])
+    expect(store.getSnapshot().commentsByPlan[planKey]?.map(item => item.id)).toEqual(['comment-b'])
+    store.actions.clear(planKey)
+    expect(store.getSnapshot().commentsByPlan[planKey]).toBeUndefined()
+    expect(store.getSnapshot().stagedByPlan[planKey]).toBeUndefined()
+    store.clearPersisted()
+    expect(localStorage.getItem(`dsh.plan-comments.v1.${sessionA}`)).toBeNull()
+  })
+
+  it('keeps a comment edited after staging when the older draft is delivered', () => {
+    const store = createPlanCommentsStore().create(sessionA)
+    store.actions.save(comment)
+    store.actions.stage(planKey, 'Older draft', [comment.id], 100)
+    store.actions.save({ ...comment, note: 'Updated after staging' })
+    store.actions.confirm(planKey, 'Older draft', 101)
+    expect(store.getSnapshot().commentsByPlan[planKey]).toEqual([{ ...comment, note: 'Updated after staging' }])
+  })
+
+  it('publishes missing text anchors once per change without persisting preview status', () => {
+    const store = createPlanCommentsStore().create(sessionA)
+    const notify = vi.fn()
+    store.subscribe(notify)
+    store.actions.setMissing(planKey, [comment.id])
+    store.actions.setMissing(planKey, [comment.id])
+    expect(notify).toHaveBeenCalledTimes(1)
+    expect(createPlanCommentsStore().create(sessionA).getSnapshot().missingByPlan[planKey]).toBeUndefined()
+    store.actions.setMissing(planKey, [])
+    store.actions.setMissing(planKey, [])
+    expect(notify).toHaveBeenCalledTimes(2)
+    expect(store.getSnapshot().missingByPlan[planKey]).toBeUndefined()
+  })
+
+  it('retains comments when the same invocation changes plan text and isolates other invocations', () => {
+    const store = createPlanCommentsStore().create(sessionA)
+    store.actions.save(comment)
+    store.actions.stage(planKey, 'Old revision', [comment.id], 100)
+    store.actions.setEditable(planKey, true)
+    store.actions.setMissing(planKey, [comment.id])
+    const another = planCommentKey(sessionA, 'call-b', '# Plan\nReview this text')
+    store.actions.save({ ...comment, id: 'other-comment', planKey: another })
+    const changed = planCommentKey(sessionA, 'call-a', '# Changed plan\nDifferent text')
+    store.actions.adopt(changed)
+    expect(store.getSnapshot().commentsByPlan[changed]).toEqual([{ ...comment, planKey: changed }])
+    expect(locatePlanComment('Changed planDifferent text', store.getSnapshot().commentsByPlan[changed]![0]!)).toBeUndefined()
+    expect(store.getSnapshot().commentsByPlan[another]).toEqual([{ ...comment, id: 'other-comment', planKey: another }])
+    expect(store.getSnapshot().commentsByPlan[planKey]).toBeUndefined()
+    expect(store.getSnapshot().stagedByPlan[planKey]).toBeUndefined()
+    expect(store.getSnapshot().editableByPlan[planKey]).toBeUndefined()
+    expect(store.getSnapshot().missingByPlan[planKey]).toBeUndefined()
+    const snapshot = store.getSnapshot()
+    store.actions.adopt(changed)
+    expect(store.getSnapshot()).toBe(snapshot)
+  })
+})
+
+describe('plan annotation text anchors', () => {
+  it('keeps an exact quote at its original verified text position', () => {
+    expect(locatePlanComment('Review this text', comment)).toEqual({ start: 0, end: 6 })
+  })
+
+  it('reanchors a unique unchanged quote after preceding text moves', () => {
+    expect(locatePlanComment('New: Review this text', comment)).toEqual({ start: 5, end: 11 })
+  })
+
+  it('uses surrounding context to distinguish repeated quotes', () => {
+    expect(locatePlanComment('Review other text; Review this text', comment)).toEqual({ start: 19, end: 25 })
+  })
+
+  it('leaves missing or ambiguous quotes unmarked instead of choosing the first', () => {
+    const { prefix: _prefix, suffix: _suffix, ...withoutContext } = comment
+    const { prefix: _prefixOnly, ...withoutPrefix } = comment
+    expect(locatePlanComment('Changed this text', comment)).toBeUndefined()
+    expect(locatePlanComment('prefix Review this text; Review this text', withoutContext)).toBeUndefined()
+    expect(locatePlanComment('prefix Review this text; Review this text', withoutPrefix)).toBeUndefined()
+  })
+
+  it('keeps request and session delimiters unambiguous in plan keys', () => {
+    expect(planCommentKey('session:a' as SessionId, 'call', 'text')).not.toBe(planCommentKey('session' as SessionId, 'a:call', 'text'))
+  })
+})
diff --git a/packages/client/ui-plan/tests/plan-review-surface.client.spec.tsx b/packages/client/ui-plan/tests/plan-review-surface.client.spec.tsx
